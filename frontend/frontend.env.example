# Copy to .env.local and fill in real values. .env.local is gitignored.

# From your Supabase project's Settings > API page.
# The anon key is safe to expose in frontend code — it's the public key,
# and Row Level Security policies are what actually enforce access control.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave empty for local dev — Vite's proxy (vite.config.ts) routes /api to
# localhost:8787 automatically. Set to your deployed Render backend URL
# (no trailing slash) when building for production, e.g. on Vercel.
VITE_API_BASE_URL=
