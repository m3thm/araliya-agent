# Copy to .env and fill in real values. .env is gitignored.

# From your Supabase project's Settings > API page.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — full read/write access, bypasses Row Level Security.
# Keep this out of any client-facing code or repo. Backend-only.
SUPABASE_SERVICE_ROLE_KEY=

# From https://openrouter.ai
OPENROUTER_API_KEY=
# Optional — defaults to openai/gpt-4o-mini if unset.
OPENROUTER_MODEL=

# Optional — defaults to https://mcp.kapruka.com/mcp if unset.
MCP_SERVER_URL=

# Optional locally. In production, set this to your deployed frontend's
# URL (e.g. https://araliya.vercel.app) to restrict which origins can call
# this API. Comma-separate multiple origins. Left unset, CORS stays open.
CORS_ORIGIN=

# Render sets this automatically — no need to set it yourself there.
PORT=8787
